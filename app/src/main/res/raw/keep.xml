<?xml version="1.0" encoding="utf-8"?>
<!-- default_web_client_id is generated by the Google Services plugin and
     read only reflectively (Resources.getIdentifier) in FirebaseKit, so the
     resource shrinker would strip it as unused and Google sign-in would
     silently stay unavailable. Keep it explicitly. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/default_web_client_id" />
